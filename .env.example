# Copy to .dev.vars. Local overrides of the production [vars] in wrangler.jsonc.
APP_ENV=development
APP_URL=http://localhost:5173

# VITE_* keys feed `vite dev` only; production builds never read this file.
VITE_SENTRY_DSN=

# Better Auth (api/_lib/auth.ts). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Google OAuth client. Authorized redirect URI for local dev:
#   http://localhost:5173/api/auth/callback/google
# Without these the "Continue with Google" button errors; email/password works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local dev points at the local Neon database directly (prod uses Hyperdrive).
# Wrangler also needs the same URL as the HYPERDRIVE binding's local stand-in —
# put this one line in a gitignored `.env` (Wrangler CLI env, not .dev.vars):
#   CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=<same as DATABASE_URL>
DATABASE_URL=postgres://user:password@localhost:5432/vibe_translate

# 32-byte base64 secret for AES-GCM encryption of BYOK keys. Generate with:
#   openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=
# Sends verification + password-reset emails. Unset locally → the worker logs
# the link instead ("[auth] … → email: url"). Required in production.
RESEND_API_KEY=

# Verified sender for transactional email, e.g. "Vibe Translate <hi@vibetranslate.app>".
RESEND_FROM=
DODO_API_KEY=
DODO_WEBHOOK_SECRET=

# Dodo product ids per plan + billing period (from the Dodo dashboard). Used to
# build checkout sessions and to resolve a webhook's plan when metadata is absent.
DODO_PRODUCT_PRO=
DODO_PRODUCT_PRO_ANNUAL=
DODO_PRODUCT_TEAM=
DODO_PRODUCT_TEAM_ANNUAL=

# Single key for all model calls — translate/explain/dictation (chat) and
# embeddings (openai/text-embedding-3-small via OpenRouter).
OPENROUTER_API_KEY=

# Optional per-task model + reasoning overrides (see docs/adr/0003). When set,
# `*_MODEL` overrides the `models` registry default for that task (a user's BYOK
# model still wins); `*_REASONING` is the OpenRouter reasoning setting —
# `none` (disable), `minimal`|`low`|`medium`|`high` (effort), or blank for the
# model default. The worker reads these from .dev.vars locally.
TRANSLATE_MODEL=x-ai/grok-4.3
TRANSLATE_REASONING=low
EXPLAIN_MODEL=openai/gpt-5.4-nano
EXPLAIN_REASONING=medium
DICTATION_MODEL=
DICTATION_REASONING=

ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_YAKUZA=
ELEVENLABS_VOICE_FRIEND=
ELEVENLABS_VOICE_CASUAL=
ELEVENLABS_VOICE_KEIGO=
ELEVENLABS_VOICE_KEIGOPLUS=
ELEVENLABS_VOICE_EMPEROR=
