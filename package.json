{
  "name": "vibe-translate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:vite": "vite",
    "dev:full": "concurrently -k -n worker,vite -c cyan,magenta \"pnpm dev\" \"pnpm dev:vite\"",
