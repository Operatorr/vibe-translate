# Cloudflare static-asset headers. Share links carry a capability token in the
# path; keep them out of search indexes and never leak the URL via Referer.
# The API side (/api/share/*) sets the same headers in api/app.ts.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
# Versioned by path (build/kuromoji-dict.ts), so safe to cache forever.
/dict/*
  Cache-Control: public, max-age=31536000, immutable

/share/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
  Cache-Control: no-store
